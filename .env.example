# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LotusMart
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/lotusmart

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Brevo (Sendinblue) Email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@lotusmart.com
BREVO_SENDER_NAME=LotusMart

# Shipmozo (Shipping)
SHIPMOZO_BASE_URL=https://shipping-api.com/app/api/v1
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=

# Admin seed
ADMIN_EMAIL=admin@lotusmart.com
ADMIN_PASSWORD=Admin@123456
