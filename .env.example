# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LotusMart
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/lotusmart

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google Sign-In (Google Identity Services)
# Create at https://console.cloud.google.com > APIs & Services > Credentials
# OAuth 2.0 Client ID (Web application). Add NEXT_PUBLIC_APP_URL as an
# Authorized JavaScript origin.
GOOGLE_CLIENT_ID=585136700835-c111hlrpa1d8srsv35se1agec07btoc6.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=585136700835-c111hlrpa1d8srsv35se1agec07btoc6.apps.googleusercontent.com

# Google Maps + Places (for GPS/address picker)
# Enable: Maps JavaScript API, Places API, Geocoding API.
# Restrict the key to your domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Brevo (Sendinblue) Email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@lotusmart.com
BREVO_SENDER_NAME=LotusMart

# Shipmozo (Shipping)
SHIPMOZO_BASE_URL=https://shipping-api.com/app/api/v1
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=

# Admin seed
ADMIN_EMAIL=dummy
ADMIN_PASSWORD=dummy
