# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LotusMart
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/lotusmart

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# NextAuth (optional OAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=                          # Cloudflare Account ID
R2_ACCESS_KEY_ID=                       # R2 API token → Access Key ID
R2_SECRET_ACCESS_KEY=                   # R2 API token → Secret Access Key
R2_ASSETS_BUCKET=lotusmart-assets       # Bucket for products, banners, categories
R2_PROFILES_BUCKET=lotusmart-profiles   # Bucket for user avatars
R2_ASSETS_PUBLIC_URL=                   # e.g. https://assets.lotusmart.com
R2_PROFILES_PUBLIC_URL=                 # e.g. https://profiles.lotusmart.com

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Brevo (Sendinblue) Email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@lotusmart.com
BREVO_SENDER_NAME=LotusMart

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external

# Redis (optional caching)
REDIS_URL=

# Admin seed
ADMIN_EMAIL=admin@lotusmart.com
ADMIN_PASSWORD=Admin@123456
